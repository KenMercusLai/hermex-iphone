#!/usr/bin/env python3
"""Package an unsigned iPhoneOS build for Sideloadly re-signing, not direct install."""
import argparse
from pathlib import Path
import plistlib
import shutil
import tempfile
import zipfile


def package_app(app: Path, output: Path) -> None:
    app = app.resolve(strict=True)
    output = output.resolve()
    if app.suffix != ".app" or not app.is_dir():
        raise ValueError("Expected an iPhoneOS .app directory")
    info = plistlib.loads((app / "Info.plist").read_bytes())
    if info.get("CFBundleSupportedPlatforms") != ["iPhoneOS"]:
        raise ValueError("Refusing to package a non-device build as an iPhone IPA")
    executable = info.get("CFBundleExecutable", "")
    if not executable or Path(executable).name != executable or not (app / executable).is_file():
        raise ValueError("The app executable is missing")
    if output.exists() or app == output or app in output.parents:
        raise ValueError("Output must be new and outside the source app")
    if any(path.is_symlink() for path in app.rglob("*")):
        raise ValueError("Symlinks require explicit review before IPA packaging")
    # This tool changes the bundle plist and removes extensions, so a previously
    # signed product must not be relabelled as still signed after packaging.
    if (app / "_CodeSignature").exists() or (app / "embedded.mobileprovision").exists():
        raise ValueError("Use a CODE_SIGNING_ALLOWED=NO build; signing belongs to Sideloadly")
    output.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix="hermex-ipa-") as directory:
        root = Path(directory)
        staged = root / "Payload" / app.name
        shutil.copytree(app, staged)
        plugins = staged / "PlugIns"
        if plugins.exists():
            shutil.rmtree(plugins)
        # The main-app-only test flavor cannot provide a widget, share extension
        # or notification service. Do not advertise unsupported Live Activities.
        info["NSSupportsLiveActivities"] = False
        info["NSSupportsLiveActivitiesFrequentUpdates"] = False
        # Fail closed before any shared push Keychain access/registration.
        # Normal login still uses the signer's default Keychain group.
        info["HermesKeychainAccessGroup"] = ""
        info["HermesAPSEnvironment"] = "disabled"
        (staged / "Info.plist").write_bytes(plistlib.dumps(info))
        temporary = root / "result.ipa"
        with zipfile.ZipFile(temporary, "w", zipfile.ZIP_DEFLATED, compresslevel=6) as archive:
            for path in sorted(staged.rglob("*")):
                if path.is_file():
                    archive.write(path, path.relative_to(root))
        with zipfile.ZipFile(temporary) as archive:
            if archive.testzip() is not None:
                raise ValueError("IPA ZIP integrity check failed")
        # Exclusive creation refuses an output another build published meanwhile.
        try:
            with output.open("xb") as destination, temporary.open("rb") as source:
                shutil.copyfileobj(source, destination)
        except FileExistsError:
            raise
        except BaseException:
            output.unlink(missing_ok=True)
            raise


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--app", type=Path, required=True)
    parser.add_argument("--output", type=Path, required=True)
    arguments = parser.parse_args()
    package_app(arguments.app, arguments.output)
    print(f"Created unsigned main-app-only IPA for re-signing: {arguments.output}")
    print("Not directly installable. Sign with your own account in Sideloadly.")
    print("Share extension, Live Activities and remote push are not supported by this test flavor.")


if __name__ == "__main__":
    main()
